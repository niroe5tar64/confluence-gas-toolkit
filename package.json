{
  "name": "confluence-gas-toolkit",
  "version": "0.1.2",
  "description": "Toolkit for Google Apps Script",
  "author": "futakuchi-eitaro",
  "type": "module",
  "module": "index.ts",
  "devDependencies": {
    "@biomejs/biome": "^2.6.3",
    "@google/clasp": "^3.4.1",
    "@topcli/prompts": "^4.0.0",
    "@types/bun": "^1.4.4",
    "@types/fs-extra": "^11.0.4",
    "@types/google-apps-script": "^2.0.13",
    "fs-extra": "^11.4.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  },
  "peerDependencies": {
    "typescript": "^7.0.0"
  },
  "scripts": {
    "build": "bun run ./bin/build.ts src/index.ts dist/index.js",
    "init": "bun run ./bin/init/index.ts",
    "deploy": "bun run ./bin/deploy.ts",
    "deploy:prod": "bun run ./bin/deploy.ts --prod",
    "push": "bun run ./bin/push.ts",
    "push:prod": "bun run ./bin/push.ts --prod",
    "open": "bun run ./bin/open.ts",
    "open:prod": "bun run ./bin/open.ts --prod",
    "format": "biome format --write .",
    "lint": "biome lint --write .",
    "check": "biome check --write .",
    "typecheck": "tsc --noEmit",
    "validate": "bun run typecheck && bun run check"
  },
  "overrides": {
    "zod": "^4.6.6"
  }
}
